# WhatsApp Cloud API (Meta developer dashboard)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Comma separated, digits only, with country code. Example: 15551234567,919876543210
ALLOWED_PHONES=

# Models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Morning brief (optional). Same value as BRIDGE_SECRET in the Apps Script bridge.
# Generate one with: openssl rand -hex 32
BRIDGE_SECRET=
# Name of an approved WhatsApp template with a "Show my brief" quick reply button.
# Without it, a brief that can't be delivered waits silently until you next message Backpocket.
WHATSAPP_BRIEF_TEMPLATE=
WHATSAPP_BRIEF_TEMPLATE_LANG=en
